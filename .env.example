# Copy to .env.local. Never commit real values.

# ---- Supabase (required for /login, /dashboard, /admin) ----
# Project Settings → API. The publishable key is safe in the browser; RLS
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. Server only: webhooks, the job runner, checkout,
# order provisioning, onboarding domain steps. Bypasses RLS — treat it like a
# database password.
SUPABASE_SECRET_KEY=

# Canonical origin used in magic-link redirects and emails. Falls back to the
# request host when unset; set it in production so links never point at a
# preview.
NEXT_PUBLIC_APP_URL=https://www.vigilstudios.co

# ---- Providers (master architecture §7). `null` boots with no credentials. ----
BILLING_PROVIDER=stripe     # null | stripe (stripe needs STRIPE_SECRET_KEY, else the stub answers)
DEPLOYMENT_PROVIDER=null    # null | vercel (adapter not built yet)
DOMAIN_PROVIDER=null        # null | cloudflare (adapter not built yet)

# ---- Stripe ----
STRIPE_SECRET_KEY=           # sk_test_… first, sk_live_… when going live
STRIPE_WEBHOOK_SECRET=       # whsec_… from the endpoint (or `stripe listen`)
STRIPE_TAX=false             # true to let Stripe Tax calculate tax at checkout

# ---- Email (Resend). Unset = every message is logged, none sent. ----
RESEND_API_KEY=
EMAIL_FROM="Vigil Studios <hello@vigilstudios.co>"
EMAIL_REPLY_TO=hello@vigilstudios.co
STAFF_NOTIFY_EMAIL=hello@vigilstudios.co

# ---- Checkout copy ----
NEXT_PUBLIC_TERMS_URL=       # service agreement link shown at checkout
NEXT_PUBLIC_REFUND_NOTE=     # one line, e.g. "Build fees are refundable until work starts."

# ---- Onboarding ----
# What Virtue promises after the brief is sent ("you'll hear from us within …").
NEXT_PUBLIC_ONBOARDING_RESPONSE_WINDOW="two business days"
# Standard DNS targets shown to customers connecting their own domain before a
# provider site exists. The deployment provider supplies exact values later.
VIGIL_DNS_APEX_A=            # e.g. 76.76.21.21 (Vercel)
VIGIL_DNS_CNAME_TARGET=      # e.g. cname.vercel-dns.com

# ---- Job runner ----
# Shared secret for POST /api/jobs/run (Vercel Cron sends it as a Bearer token).
VIGIL_JOBS_SECRET=

# ---- Site export ----
# Where customer site folders live (websites.repository_ref, e.g. clients/<org-slug>,
# is resolved under this). Default: the parent folder of this repo.
VIGIL_CLIENTS_ROOT=
