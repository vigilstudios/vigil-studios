# Copy to .env.local. Never commit real values.

# ---- Supabase (required for /login, /dashboard, /admin) ----
# Project Settings → API. The publishable key is safe in the browser; RLS
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. Server only: webhooks, the job runner, staff
# bootstrap. Bypasses RLS — treat it like a database password.
SUPABASE_SECRET_KEY=

# Canonical origin used in magic-link redirects. Falls back to the request
# host when unset; set it in production so links never point at a preview.
NEXT_PUBLIC_APP_URL=https://www.vigilstudios.co

# ---- Providers (master architecture §7). `null` boots with no credentials. ----
BILLING_PROVIDER=null       # null | stripe
DEPLOYMENT_PROVIDER=null    # null | vercel
DOMAIN_PROVIDER=null        # null | cloudflare

# ---- Job runner ----
# Shared secret for POST /api/jobs/run (Vercel Cron sends it as a Bearer token).
VIGIL_JOBS_SECRET=
