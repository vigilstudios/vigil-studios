# Copy to .env.local. Never commit real values.

# ---- Supabase (required for /login, /dashboard, /admin) ----
# Project Settings → API. The publishable key is safe in the browser; RLS
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. Server only: webhooks, the job runner, checkout,
# order provisioning, onboarding domain steps, rate limits, audit rows.
# Bypasses RLS — treat it like a database password.
SUPABASE_SECRET_KEY=
# Vercel preview deployments refuse to use the service role even when the key
# is present, so a preview can never provision, run jobs or answer webhooks
# against the production database. Set to `allow` only on a preview that
# points at its own Supabase project.
# VIGIL_PREVIEW_SERVICE_ROLE=allow

# Canonical origin used in magic-link redirects and emails. Falls back to the
# request host when unset; set it in production so links never point at a
# preview.
NEXT_PUBLIC_APP_URL=https://www.vigilstudios.co

# ---- Providers (master architecture §7). `null` boots with no credentials. ----
BILLING_PROVIDER=stripe     # null | stripe (stripe needs STRIPE_SECRET_KEY, else the stub answers)
DEPLOYMENT_PROVIDER=vercel  # null | vercel
DOMAIN_PROVIDER=null        # null | cloudflare (adapter not built yet)

# ---- Customer source repositories (GitHub) ----
# Token needs permission to create private repositories and write Contents in
# the owner below. For an organization, its GitHub App must also be installed.
GITHUB_TOKEN=
GITHUB_OWNER=vigilstudios
GITHUB_OWNER_TYPE=organization # organization | user
GITHUB_REPOSITORY_PREFIX=client

# ---- Vercel customer sites ----
# Install/authorize Vercel's GitHub integration for GITHUB_OWNER so Vercel can
# import each private repository. Omit VERCEL_TEAM_ID for a personal account.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---- Creative Workspace (Terra) ----
# After Create Repo, Vigil writes `.vigil/creative/` into the customer
# repository. Terra (OpenAI Responses API, structured output) normalises the
# brief; without a key the workspace is still written and the admin sees a
# warning that intelligence is missing. Retry from the website page.
CREATIVE_PROVIDER=openai          # openai | null (null = never call a model)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
CREATIVE_MODEL=gpt-5.6-terra
CREATIVE_REASONING_EFFORT=medium  # minimal | low | medium | high
CREATIVE_MAX_OUTPUT_TOKENS=16000
CREATIVE_MAX_INPUT_CHARS=60000    # customer text sent to the model; longer briefs are truncated
CREATIVE_REQUEST_TIMEOUT_MS=180000
# Git inclusion policy: assets at or under this size are copied into the
# repository (up to the total budget per workspace); larger ones, anything
# past the budget, and every type prefix listed stay in storage and appear
# as manifest entries plus a small .reference.json.
CREATIVE_ASSET_INLINE_MAX_BYTES=26214400
CREATIVE_ASSET_INLINE_TOTAL_MAX_BYTES=629145600
CREATIVE_ASSET_EXTERNAL_TYPES=video/
# Text layer of customer PDFs (pdf-parse; no rendering, no OCR) goes to Terra
# and to source/documents/. Off, or above the size, the PDF is listed only.
CREATIVE_DOCUMENT_TEXT=true
CREATIVE_DOCUMENT_TEXT_MAX_BYTES=15728640
CREATIVE_DOCUMENT_TEXT_MAX_CHARS=20000
# Which project kinds get a workspace automatically after Create Repo
# (comma list, or `all`). Staff can always generate one from the website page.
CREATIVE_WORKSPACE_PROJECT_KINDS=professional,custom

# ---- Stripe ----
STRIPE_SECRET_KEY=           # sk_test_… first, sk_live_… when going live
STRIPE_WEBHOOK_SECRET=       # whsec_… from the endpoint (or `stripe listen`)
STRIPE_TAX=true              # customers pay sales tax at checkout (Stripe Tax; needs registrations in Stripe → Settings → Tax)
CHECKOUT_PROMOTION_CODES=true # show Stripe's "Add promotion code" field at checkout (codes are created in Stripe)

# ---- Email (Resend). Unset = every message is logged, none sent. ----
RESEND_API_KEY=
EMAIL_FROM="Vigil Studios <hello@vigilstudios.co>"
EMAIL_REPLY_TO=hello@vigilstudios.co
STAFF_NOTIFY_EMAIL=hello@vigilstudios.co

# ---- Checkout copy ----
NEXT_PUBLIC_TERMS_URL=       # service agreement link shown at checkout
NEXT_PUBLIC_REFUND_NOTE=     # one line, e.g. "Build fees are refundable until work starts."

# ---- Onboarding ----
# What Virtue promises after the brief is sent ("you'll hear from us within …").
NEXT_PUBLIC_ONBOARDING_RESPONSE_WINDOW="two business days"
# Standard DNS targets shown to customers connecting their own domain before a
# provider site exists. The deployment provider supplies exact values later.
VIGIL_DNS_APEX_A=76.76.21.21
VIGIL_DNS_CNAME_TARGET=cname.vercel-dns-0.com

# ---- Domain Engine v2 (disabled until reviewed migrations and provider approval) ----
VIGIL_DOMAIN_ENGINE_ENABLED=false
VIGIL_DOMAIN_SEARCH_ENABLED=false
VIGIL_DOMAIN_REGISTRAR=disabled
# Local-only fictional client workspace. Rejected in production, even if true.
VIGIL_DOMAIN_MOCK_ENABLED=false
# JSON object of key-id -> base64-encoded 32-byte encryption key. Server only.
VIGIL_DOMAIN_ENCRYPTION_KEYS={}
VIGIL_DOMAIN_ACTIVE_KEY_ID=
# Isolated Stripe test account only. Live keys are rejected by the domain adapter.
VIGIL_DOMAIN_STRIPE_TEST_KEY=
VIGIL_DOMAIN_STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_VIGIL_DOMAIN_STRIPE_TEST_KEY=
# Must match NEXT_PUBLIC_SUPABASE_URL for a separate, explicitly approved test project.
VIGIL_DOMAIN_TEST_DATABASE_APPROVED=false
VIGIL_DOMAIN_TEST_SUPABASE_URL=
# Fixed sandbox API only; no production account funding or operations.
VIGIL_OPENPROVIDER_SANDBOX_TOKEN=
VIGIL_OPENPROVIDER_SANDBOX_ACCOUNT_ID=
# Name.com CORE v1 sandbox only. Use the displayed Development/Test username (-test).
# Maximum sandbox base registrar cost in USD cents; no live billing permission.
VIGIL_NAMECOM_SANDBOX_USERNAME=
VIGIL_NAMECOM_SANDBOX_TOKEN=
VIGIL_NAMECOM_SANDBOX_MAX_COST_MINOR=
# Prepared Cloudflare transport only: local tests require separately recorded
# explicit approval for each exact hostname. Production writes remain blocked.
VIGIL_DOMAIN_DNS_WRITES_APPROVED=false
VIGIL_DOMAIN_DNS_APPROVAL_REFERENCE=
VIGIL_DOMAIN_DNS_APPROVED_HOSTNAMES=
# Dashboard reminders/support tickets only; never automatically renews or charges.
VIGIL_DOMAIN_LIFECYCLE_NOTIFICATIONS_ENABLED=false

# ---- Job runner ----
# Shared secret for POST /api/jobs/run (Vercel Cron sends it as a Bearer token).
VIGIL_JOBS_SECRET=
# Vercel Cron automatically sends this value as its Bearer token.
CRON_SECRET=

# ---- Legacy/local site export ----
# GitHub-backed repositories use GITHUB_TOKEN above. This optional root keeps
# exports working for older local `clients/<org-slug>` repository references.
VIGIL_CLIENTS_ROOT=..

# Vercel public discovery + saved external handoff; requires migration 0047.
# Automatic customer DNS remains disabled independently of this switch.
DOMAIN_HANDOFF_ENABLED=false

# ---- Personal Gmail draft replies (Google OAuth Web application) ----
# Enable Gmail API and register this exact redirect in Google Cloud.
# gmail.compose is a restricted Google scope; finish the applicable OAuth review.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://www.vigilstudios.co/api/gmail/callback

# Optional isolated Name.com lifecycle tests. These never enable production operations.
VIGIL_DOMAIN_LIFECYCLE_SYNC_ENABLED=false
# Exact configured subscription URL and sandbox signing token (earliest token per Name.com).
# Leave unset until the signing key is confirmed; a test-signed fixture is not vendor delivery.
VIGIL_NAMECOM_SANDBOX_WEBHOOK_URL=
VIGIL_NAMECOM_SANDBOX_WEBHOOK_TOKEN=

# ---- Domain Engine reviewed live runtime (all live operations remain off by default) ----
# Also requires a durable, scoped policy/release row installed after explicit owner approval.
VIGIL_DOMAIN_LIVE_ENABLED=false
VIGIL_NAMECOM_USERNAME=
VIGIL_NAMECOM_TOKEN=
VIGIL_DOMAIN_STRIPE_LIVE_KEY=
VIGIL_DOMAIN_STRIPE_ACCOUNT_ID=
NEXT_PUBLIC_VIGIL_DOMAIN_STRIPE_LIVE_KEY=
VIGIL_DOMAIN_STRIPE_LIVE_WEBHOOK_SECRET=
# Exact public subscription URL + confirmed Name.com signing key.
VIGIL_NAMECOM_WEBHOOK_URL=
VIGIL_NAMECOM_WEBHOOK_TOKEN=
# Client-supplied, zone-limited Cloudflare tokens require exact release and plan consent.
VIGIL_DOMAIN_CLOUDFLARE_ENABLED=false

# Isolated sandbox quote fixtures only. Production pricing uses approved policy rows.
VIGIL_DOMAIN_TEST_SERVICE_FEE_MINOR=0
VIGIL_DOMAIN_TEST_MAX_TOTAL_MINOR=3000
